# 后端接口地址（dev 环境由 vite proxy 转发到 CMP 内网后端，见 vite.config.ts）
VITE_API_BASE_URL=/api

# 是否使用本地 mock 假数据
# ⚠️ 混用策略（重要）：
#   - 老模块（登录 / 许可作业 / 角色 / 首页看板）**后端还没有接口**，靠这个开关继续走 mock；
#   - 新模块（警报 / 账号 / 相册 / 照片墙）的 api 文件里**不读这个开关**，一律打真实接口。
#   等后端补齐接口后，把对应模块的 mock 分支删掉、再关掉这个开关即可。
VITE_USE_MOCK=true

# 是否开启登录校验：true = 未登录跳登录页，false = 随便看（纯看壳子时可关掉）
VITE_USE_AUTH=true

# 左侧菜单来源：
#   static = 读 config/menu.ts 静态配置（默认，界面跟设计图一致）
#   remote = 调 /menu/routes 拿后端下发的菜单树（失败自动回退 static）
#   auto   = 先试接口、失败回退 static（后端就绪后推荐用这个）
VITE_MENU_SOURCE=static

# 应用标题
VITE_APP_TITLE=CMP3.0 Admin

# 图片 / 视频等静态资源的根地址
# 后端返回的是相对根目录路径（如 /user/xxx/yyy.png），前端要拼上这个前缀才能显示。
# 生产环境改成实际的静态资源域名即可。
VITE_ASSET_BASE_URL=http://192.168.77.15:82

# 演示模式：本地开发**永远关掉**，必须走真实接口（mock 数据只在公网部署时用）
VITE_DEMO_MODE=false

# ============================================================
# 用户级 token（后端 2026-10-17 文档确定）
# ============================================================
# 登录响应体**顶层**返回 token（与 data 平级）：{"code":"SUCCESS","token":"xxx","data":{...}}
# 之后每个请求带：Authorization: Bearer <token>
# 后端用它识别"当前登录的是谁"，所有按账号返回数据的接口不再需要前端传 UserId。
VITE_AUTH_TOKEN_HEADER=Authorization
VITE_AUTH_TOKEN_PREFIX=Bearer

# 默认语言：zh-TW / zh-CN / en（繁 / 简 / 英，默认繁体）
VITE_DEFAULT_LOCALE=zh-TW
