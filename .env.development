# 后端接口地址（后续对接真实接口时改这里）
VITE_API_BASE_URL=/api

# 是否使用本地 mock 假数据：true = 用 mock，false = 打真实接口
VITE_USE_MOCK=true

# 是否开启登录校验：true = 未登录跳登录页，false = 随便看（纯看壳子时可关掉）
VITE_USE_AUTH=true

# 左侧菜单来源：
#   static = 读 config/menu.ts 静态配置（默认，界面跟设计图一致）
#   remote = 调 /menu/routes 拿后端下发的菜单树（失败自动回退 static）
#   auto   = 先试接口、失败回退 static（后端就绪后推荐用这个）
VITE_MENU_SOURCE=static

# 应用标题
VITE_APP_TITLE=CMP3.0 Admin
