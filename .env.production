VITE_API_BASE_URL=/api
VITE_USE_MOCK=true
VITE_USE_AUTH=true
VITE_MENU_SOURCE=static
VITE_APP_TITLE=CMP3.0 Admin
VITE_DEFAULT_LOCALE=zh-TW

# ============================================================
# 演示模式（公网部署用）
# ============================================================
# 为什么开：Cloudflare Pages 是纯静态托管，没有任何办法访问内网接口
#   （192.168.77.15 是私有地址，公网路由不到；也没有代理层）。
#   为了让界面能被看到，生产构建内置一套示例数据，并在页面顶部常驻
#   「演示模式」横幅，避免被误认为真实数据。
#
# 什么时候关：后端提供**公网 https 接口地址**之后
#   1) VITE_API_BASE_URL 改成那个地址
#   2) 这里改成 false
#   3) 重新部署即可，业务代码不用动
VITE_DEMO_MODE=true

# 生产环境没有 vite 代理，静态资源（图片/视频）需要绝对地址。
# 后端给公网地址后同步改这里，或者如果前后端同域就留空。
VITE_ASSET_BASE_URL=

# ============================================================
# 用户级 token（后端 2026-10-17 决定用 token 做身份校验）
# ============================================================
# 放在哪个请求头、要不要前缀，**等后端定了改这里就行，代码不用动**。
# 如果后端用 Authorization + Bearer，改成：
#   VITE_AUTH_TOKEN_HEADER=Authorization
#   VITE_AUTH_TOKEN_PREFIX=Bearer
VITE_AUTH_TOKEN_HEADER=UserToken
VITE_AUTH_TOKEN_PREFIX=
